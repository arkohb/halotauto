generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Trade record (paper + live broker executions)
model Trade {
  id            String    @id @default(cuid())
  mode          String // BOT | SCAN | MANUAL | BACKTEST
  execMode      String    @default("PAPER") // PAPER | LIVE
  brokerKind    String    @default("")
  brokerOrderId String    @default("")
  symbol        String
  timeframe     String
  direction     Int // -1 = SELL (short) · +1 = BUY (long)
  entry         Float
  sl            Float
  tp            Float
  riskPips      Float
  rewardPips    Float
  status        String // OPEN | WIN | LOSS | REJECTED
  resultPips    Float?
  levelTop      Float // C1/C2 zone top
  levelBot      Float // C1/C2 zone bottom
  slMode        String // Fixed points | C3 wick + buffer | ATR
  note          String    @default("")
  // EDGE · Signal Quality Score at fire time (null = fired before EDGE / ungraded)
  grade         Int?
  gradeLetter   String    @default("")
  sizeMult      Float     @default(1) // grade × Capital Guardian size multiplier applied
  partialPips   Float? // Smart Trade Manager: signed pips banked by a partial close
  openedAt      DateTime
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
}

// Singleton bot config row (id = "main")
model BotConfig {
  id              String   @id @default("main")
  enabled         Boolean  @default(false)
  autoAttach      Boolean  @default(true) // EA auto-attaches to the chart & auto-starts on boot
  pauseNew        Boolean  @default(false) // operator pause: block NEW entries, keep managing an open trade
  symbol          String   @default("BTCUSDT")
  timeframe       String   @default("5m")
  configJson      String   @default("{}") // full HALO 3EL settings JSON
  startingPips    Float    @default(0)
  realizedPips    Float    @default(0)
  lastFeedSource  String   @default("binance")
  executionMode   String   @default("paper") // paper | live
  brokerAccountId String    @default("")
  sizingMode      String   @default("fixed") // fixed | percent
  sizeFixed       Float    @default(0.01)
  sizePercent     Float    @default(1.0)
  updatedAt       DateTime @updatedAt
}

// CFD broker connection (real orders)
model BrokerAccount {
  id          String    @id @default(cuid())
  kind        String // paper | oanda | ig | metaapi | binance | fxcm | ctrader | deriv | webhook
  label       String
  credsJson   String // credentials JSON (kept server-side only)
  status      String    @default("untested") // untested | ok | error
  statusMsg   String    @default("")
  active      Boolean   @default(false)
  lastCheckAt DateTime?
  createdAt   DateTime  @default(now())
}

// Alert channel settings (id = "main")
model AlertSettings {
  id               String   @id @default("main")
  telegramEnabled  Boolean  @default(false)
  telegramBotToken String   @default("")
  telegramChatId   String   @default("")
  emailEnabled     Boolean  @default(false)
  smtpHost         String   @default("")
  smtpPort         Int      @default(587)
  smtpSecure       Boolean  @default(false)
  smtpUser         String   @default("")
  smtpPass         String   @default("")
  smtpFrom         String   @default("")
  smtpTo           String   @default("")
  pushEnabled      Boolean  @default(true)
  eventsJson       String   @default("{\"fire\":true,\"win\":true,\"loss\":true,\"scanner\":true,\"broker\":true,\"status\":false}")
  vapidPublicKey   String   @default("")
  vapidPrivateKey  String   @default("")
  updatedAt        DateTime @updatedAt
}

// TradingView webhook receiver (id = "tv") — attaches the EA to any
// TradingView chart: Pine EA alert → this webhook → linked broker account
model WebhookConfig {
  id         String    @id @default("tv")
  secret     String    @default("") // shared secret embedded in the alert JSON
  enabled    Boolean   @default(true)
  fireCount  Int       @default(0)
  lastFireAt DateTime?
  updatedAt  DateTime  @updatedAt
}

// Web-push device subscription
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// Delivery log for every alert attempt
model AlertLog {
  id        String   @id @default(cuid())
  kind      String // fire | win | loss | scanner | broker | status | test
  channel   String // telegram | email | push | app
  title     String
  body      String
  ok        Boolean
  error     String   @default("")
  createdAt DateTime @default(now())
}

// Trader profile + HALO voice-assistant preferences (id = "main").
// Presentation layer ONLY — never read by the trading engine, execution
// path, risk controls or broker integration.
model TraderProfile {
  id           String   @id @default("main")
  displayName  String   @default("")   // preferred spoken/display name; empty → "Trader"
  voiceEnabled Boolean  @default(false) // consent: spoken welcome + spoken replies (TTS)
  wakeEnabled  Boolean  @default(false) // consent: wake-word microphone listening
  wakePhrase   String   @default("halo") // wake word/phrase, matched in speech
  autoGreeting Boolean  @default(true)  // speak the personalized welcome on return visits
  updatedAt    DateTime @updatedAt
}

// Audit trail for consequential HALO operator actions (voice or text).
// Written ONLY by /api/halo/brain when an allowlisted action actually
// executes (or is rejected) — presentation data, never read by the
// trading engine, execution path, risk controls or broker integration.
model ActionAudit {
  id        String   @id @default(cuid())
  action    String // registry action id, e.g. pause_new_entries
  paramsJson String  @default("{}")
  source    String   @default("text") // voice | text
  outcome   String // executed | rejected | failed | expired
  detail    String   @default("")
  createdAt DateTime @default(now())
}

// Multi-symbol scanner watchlist
model ScannerSymbol {
  id        String   @id @default(cuid())
  symbol    String
  tf        String   @default("5m")
  enabled   Boolean  @default(true)
  autoTrade Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([symbol, tf])
}

// Trader-authored Pine Script strategy (Strategy Studio).
// The trader pastes a Pine v5 script; the compiler turns it into a real
// indicator (chart plots) + optional auto-trading signals. Exactly ONE
// strategy can be active for auto-trading at a time (active=true); with
// none active the bot trades the built-in HALO 3EL v1.2 engine.
model PineStrategy {
  id           String    @id @default(cuid())
  name         String
  description  String    @default("")
  pineSource   String
  compiledJson String    @default("{}") // compiled artifact meta (plots, inputs, kind…)
  status       String    @default("draft") // draft | compiled | error
  compileMsg   String    @default("") // human-readable last compile result
  active       Boolean   @default(false) // selected as THE bot strategy
  // risk overlay — applied ONLY when the script itself sets no SL/TP
  useSlATR     Boolean   @default(true)
  slATRm       Float     @default(1.5)
  useSlPts     Boolean   @default(false)
  slPts        Float     @default(1000)
  rrMult       Float     @default(3.0)
  // manual signal mapping for indicator-only scripts (no strategy.* calls)
  signalJson   String    @default("{}") // { mode: "strategy"|"manual", longVar, shortVar, exitVar }
  lastTradedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ══════════════════════════════════════════════════════════════════════════
//  COMMERCIAL PLATFORM — accounts, plans, licenses, payments, audit
//  (Replaces the legacy single-row License gate. The owner's legacy row is
//  ported to a complimentary license by scripts/commerce-setup.ts.)
//  Enforcement is on by default (the platform is a sold product); set
//  HALO_COMMERCE=off for legacy owner mode. Consequential trading endpoints
//  require an authenticated customer with a valid license entitlement.
//  NEVER connected to open-position management or broker-side protection.
// ══════════════════════════════════════════════════════════════════════════

// Registered account. Roles: SUPER_ADMIN | LICENSE_ADMIN | SUPPORT_ADMIN | CUSTOMER
// Status: PENDING_EMAIL | PENDING_APPROVAL | ACTIVE | SUSPENDED | BLOCKED | REJECTED
model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  username            String?   @unique
  passwordHash        String
  fullName            String    @default("")
  country             String    @default("")
  role                String    @default("CUSTOMER")
  status              String    @default("PENDING_EMAIL")
  emailVerifiedAt     DateTime?
  verifyToken         String    @default("")
  resetToken          String    @default("")
  resetTokenExpiresAt DateTime?
  mustChangePassword  Boolean   @default(false) // provisioned admins
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions      Session[]
  licenses      License[]
  payments      Payment[]
  notifications Notification[]
}

// DB-backed session — instant revocation when an account is suspended/blocked.
model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique // sha256(raw cookie token)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String    @default("")
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
}

// Purchasable one-time plan (Starter / Pro / Elite / Ultimate). Editable by
// the Super Administrator. Changing a plan NEVER changes existing licenses —
// each license stores its own entitlement snapshot at issuance.
model Plan {
  id              String   @id @default(cuid())
  code            String   @unique // STARTER | PRO | ELITE | ULTIMATE
  name            String
  tagline         String   @default("")
  description     String   @default("")
  priceCents      Int
  currency        String   @default("USD")
  promoPriceCents Int?
  deviceLimit     Int      @default(1)
  featuresJson    String   @default("[]") // feature keys granted to NEW purchases
  icon            String   @default("shield")
  active          Boolean  @default(true)
  displayOrder    Int      @default(0)
  updatedAt       DateTime @updatedAt

  payments Payment[]
}

// Lifetime (or custom-expiry) license. Entitlement snapshot preserved.
model License {
  id                String    @id @default(cuid())
  key               String    @unique // HALO-XXXX-XXXX-XXXX-XXXX (CSPRNG)
  userId            String?
  user              User?     @relation(fields: [userId], references: [id])
  planCode          String // snapshot of plan at issuance
  planName          String
  entitlementsJson  String    @default("[]") // feature keys at issuance — survives plan edits
  status            String    @default("UNACTIVATED") // UNACTIVATED | ACTIVE | SUSPENDED | REVOKED
  kind              String    @default("SINGLE_USER") // SINGLE_USER | MULTI_USER
  seatLimit         Int       @default(1)
  deviceLimit       Int       @default(1)
  isComplimentary   Boolean   @default(false)
  compReason        String    @default("")
  paymentId         String? // verified payment that produced this license
  issuedById        String? // admin identity (or "system" for payment auto-issuance)
  notes             String    @default("")
  activatedAt       DateTime?
  expiresAt         DateTime? // null = lifetime
  createdAt         DateTime  @default(now())

  activations LicenseActivation[]
}

// One activated device per row. deviceToken is a client-generated random
// secret stored locally — practical identity without invasive fingerprinting.
model LicenseActivation {
  id              String    @id @default(cuid())
  licenseId       String
  license         License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  deviceToken     String    @unique
  deviceLabel     String    @default("")
  userAgent       String    @default("")
  active          Boolean   @default(true)
  activatedAt     DateTime  @default(now())
  lastValidatedAt DateTime?
  revokedAt       DateTime?
}

// One-time payment transaction. VERIFIED only via provider webhook/verified
// API check or authorized manual verification — never from a browser redirect.
model Payment {
  id                 String    @id @default(cuid())
  reference          String    @unique // HALOPAY-…
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  planId             String
  plan               Plan      @relation(fields: [planId], references: [id])
  amountCents        Int
  currency           String
  provider           String // PAYSTACK | FLUTTERWAVE | MANUAL
  providerRef        String    @default("")
  status             String    @default("PENDING") // PENDING | VERIFIED | FAILED | CANCELLED | REFUNDED | DISPUTED
  providerMetaJson   String    @default("{}")
  adminNote          String    @default("")
  manualVerifiedById String?
  manualVerifiedAt   DateTime?
  verifiedAt         DateTime?
  licenseRef         String?   @unique // set when the license is issued — idempotency guard
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Webhook/event dedup — duplicate provider events never double-issue.
model PaymentEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String   @unique
  type        String
  payloadJson String   @default("{}")
  createdAt   DateTime @default(now())
}

// Append-only administrative audit trail. Ordinary admins cannot alter it.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String   @default("")
  actorEmail String   @default("")
  actorRole  String   @default("")
  action     String // LICENSE_GENERATED | USER_APPROVED | PAYMENT_VERIFIED | …
  targetType String   @default("")
  targetId   String   @default("")
  outcome    String   @default("success")
  metaJson   String   @default("{}")
  createdAt  DateTime @default(now())
}

// Key-value system settings (approval mode, registration open, policies…).
model SystemSetting {
  key         String   @id
  valueJson   String
  updatedById String   @default("")
  updatedAt   DateTime @updatedAt
}

// In-app customer notifications (license issued, payment verified, approval…).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // license | payment | approval | security
  title     String
  body      String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

// ══════════════════════════════════════════════════════════════════════════
//  HALO PERFORMANCE JOURNAL — presentation/analytics feature. ISOLATED:
//  never read by the trading engine, execution path, risk controls or
//  broker integration. Pure journal of CLOSED trades (MT5 history sync,
//  CSV import, manual entry or clearly-labeled demo data) + the trader's
//  own review notes. One row per completed round-trip trade.
// ══════════════════════════════════════════════════════════════════════════

model JournalTrade {
  id            String   @id @default(cuid())
  userId        String // journal owner — every query is scoped by this
  // provenance
  source        String // MT5 | CSV | MANUAL | DEMO
  brokerKind    String   @default("") // metaapi | … (empty for manual/CSV)
  brokerAccount String   @default("") // BrokerAccount id or label
  brokerLabel   String   @default("") // human label at sync time
  // stable identity — dedup + correction upserts (always non-empty)
  extKey        String // "{brokerAccountId}:{positionId}:{leg}" | "csv:{hash}" | "manual:{cuid}"
  dealIdsJson   String   @default("[]") // every MT5 deal id composing this record (audit trail)
  positionId    String   @default("") // MT5 position id (when known)
  // instrument + direction
  symbol        String
  direction     String // BUY | SELL
  volume        Float // lots (total entry volume)
  volumeExit    Float    @default(0) // total closed volume (partial closes)
  // prices
  entryPrice    Float
  exitPrice     Float
  sl            Float? // SL recorded at entry (null = not recorded)
  tp            Float?
  // timing (all instants stored UTC)
  openedAt      DateTime
  closedAt      DateTime
  durationMin   Int      @default(0) // whole minutes open
  // money (account currency) — MT5 sign convention: commission/swap usually ≤ 0
  grossProfit   Float    @default(0) // Σ deal.profit (price move only)
  commission    Float    @default(0)
  swap          Float    @default(0)
  fees          Float    @default(0) // MT5 fee field
  netPnl        Float    @default(0) // grossProfit + commission + swap + fees
  currency      String   @default("USD")
  // risk (price-based R — honest when lot contract size is unknown)
  riskPrice     Float? // |entry − sl| when SL recorded
  rMultiple     Float? // netPnl-expressed price move ÷ riskPrice
  // classification — ONLY what was actually recorded (never assumed)
  strategy      String   @default("")
  timeframe     String   @default("")
  session       String   @default("") // derived from UTC hour; labeled as derived in UI
  status        String   @default("CLOSED")
  // journaling (trader-authored)
  notes         String   @default("")
  reviewJson    String   @default("{}") // {reasonEntry,reasonExit,chartNotes,mistakes,lessons,rating}
  tagsJson      String   @default("[]") // discipline tag ids
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, extKey])
  @@index([userId, closedAt])
  @@index([userId, symbol])
}

// Per-user journal bookkeeping (sync state + broker balance operations kept
// strictly SEPARATE from trading P&L — deposits/withdrawals are never profit).
model JournalState {
  id             String    @id @default(cuid())
  userId         String    @unique
  lastSyncAt     DateTime?
  lastSyncOk     Boolean   @default(false)
  lastSyncMsg    String    @default("")
  syncBrokerId   String    @default("")
  syncLookback   Int       @default(30) // days pulled on first sync
  // balance operations seen in MT5 history: [{time,type,amount,balance}]
  balanceOpsJson String    @default("[]")
  updatedAt      DateTime  @updatedAt
}

// Daily account snapshots (equity curve data source). Only REAL observed
// values are stored — a curve "derived from closed-trade net P&L" is
// computed at read time and labeled as such in the UI, never persisted.
model JournalEquity {
  id        String   @id @default(cuid())
  userId    String
  day       String // YYYY-MM-DD (UTC)
  balance   Float
  equity    Float
  source    String   @default("MT5") // MT5 | CSV | MANUAL
  createdAt DateTime @default(now())

  @@unique([userId, day])
  @@index([userId, day])
}

// EDGE suite settings (id = "main") — Signal Quality · Trade Manager ·
// Capital Guardian · Autopilot switches, one JSON blob (see lib/edge/settings.ts)
model EdgeSettings {
  id        String   @id @default("main")
  json      String   @default("{}")
  updatedAt DateTime @updatedAt
}

// EDGE · Adaptive Autopilot walk-forward profile, one per market (symbol+tf).
// A profile is only ever an OVERLAY: the saved BotConfig is never rewritten.
model AutopilotProfile {
  id           String   @id // `${symbol}:${tf}`
  symbol       String
  timeframe    String
  paramsJson   String // winning parameter overlay
  inSampleJson String // in-sample metrics of the winner
  oosJson      String // out-of-sample metrics of the winner
  baseJson     String // out-of-sample metrics of the current settings
  combos       Int
  bars         Int
  live         Boolean  @default(false) // passed the gate AND switched on
  passed       Boolean  @default(false) // profitable on unseen data AND beats current settings
  verdict      String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// TradingView webhook replay protection: one row per accepted alert event.
// The primary key is a SHA-256 of the alert's event id, so a duplicate or
// replayed alert fails the insert — atomically, across concurrent requests
// and application restarts. Rows older than 7 days are pruned.
model TvAlertEvent {
  id         String   @id // sha256(event id)
  action     String
  symbol     String
  alertTs    DateTime // the alert's own timestamp (TradingView timenow)
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}
