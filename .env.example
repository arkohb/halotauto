# ── local development (SQLite) ──
DATABASE_URL="file:../db/custom.db"

# Claude API key — HALO's conversation brain (get one at console.anthropic.com)
ANTHROPIC_API_KEY=""

# MetaApi platform token — MT4/MT5 (create at app.metaapi.cloud → API access)
METAAPI_TOKEN=""

# OANDA fxTrade PRACTICE account — live forex/metals prices only (same as TradingView's OANDA charts).
# Market data only: HALO never trades through this. Token: OANDA hub → Manage API Access.
OANDA_PRACTICE_TOKEN=""
OANDA_PRACTICE_ACCOUNT=""   # e.g. 101-001-1234567-001

# Encryption key for stored credentials (32 bytes): openssl rand -base64 32
# Keep a copy in your password manager — encrypted credentials can't be read without it.
HALO_DATA_KEY=""

# Flutterwave (test mode first): API secret key + the "secret hash" set in the
# Flutterwave dashboard for webhooks (a separate value you choose)
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""

# ── production (Firebase App Hosting) — set as secrets, not here ──
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/halo?sslmode=require"
# HALO_CRON_SECRET="long-random-string"   # shared with the Cloudflare keep-alive worker
# ANTHROPIC_API_KEY="sk-ant-..."
# HALO_COMMERCE=on
